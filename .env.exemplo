# Copie este arquivo para .env e preencha os valores.
# O .env não vai para o repositório.

# Chave do Gemini (https://aistudio.google.com/apikey)
# Se ficar vazia, a categoria é sugerida por palavras-chave
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
IA_TIMEOUT_SEGUNDOS=5

# Banco Supabase (opcional, sem isso usa o H2 em memória)
#DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#DB_USER=postgres.SEU_PROJETO
#DB_PASSWORD=SUA_SENHA

# Segredo usado para assinar o token de login
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio-com-pelo-menos-32-caracteres