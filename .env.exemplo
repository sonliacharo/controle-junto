# Copie para ".env" e preencha. O arquivo .env NÃO vai para o GitHub.

# --- Supabase (PostgreSQL na nuvem) ---
# No Supabase: Project Settings > Database > Connection string > JDBC
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.SEU_PROJETO
DB_PASSWORD=SUA_SENHA

# --- IA (Google Gemini) - opcional ---
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Segurança ---
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio-com-pelo-menos-32-caracteres
