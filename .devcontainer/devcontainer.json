{
  "name": "ControleJunto",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "installMaven": "true" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": { "label": "Front-end (React)", "onAutoForward": "openBrowser" },
    "8080": { "label": "API (Spring Boot)" }
  },
  "postCreateCommand": "cd frontend && npm install",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-spring-boot"]
    }
  }
}
